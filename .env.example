# Copy to .env — values here are loaded at startup unless the variable is
# already set in the environment (real env vars always win). Never commit
# your .env; it is gitignored.

# --- LLM provider -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
#AI_OPS_LLM_PROVIDER=anthropic          # anthropic | openai
#AI_OPS_LLM_MODEL=claude-opus-5

# OpenAI / self-hosted OpenAI-compatible (vLLM, Ollama, LiteLLM):
#AI_OPS_LLM_PROVIDER=openai
#AI_OPS_LLM_MODEL=gpt-4.1
#OPENAI_API_KEY=sk-...
#AI_OPS_LLM_OPENAI_BASE_URL=http://localhost:11434/v1

# --- Redaction --------------------------------------------------------------
#AI_OPS_REDACT=true
#AI_OPS_REDACT_IPS=false

# --- Watch tuning -----------------------------------------------------------
#AI_OPS_WATCH_BASELINE_SECONDS=300
#AI_OPS_WATCH_COOLDOWN_SECONDS=120
#AI_OPS_WATCH_MAX_ALERTS_PER_HOUR=10

# --- Mattermost (Phase 3) ---------------------------------------------------
#AI_OPS_MATTERMOST_URL=https://mattermost.example.com
#AI_OPS_MATTERMOST_TOKEN=xxxx
#AI_OPS_MATTERMOST_TEAM=myteam
#AI_OPS_MATTERMOST_DEFAULT_CHANNEL=ops-alerts
#AI_OPS_MATTERMOST_NOISE_CHANNEL=ops-noise
